# =========================================================
# AXTEC AI — environment variables
# Copy this file to ".env" and fill in real values.
# NEVER commit ".env" or real keys to version control.
# =========================================================

# ---- Server ----
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (your site domain(s))
ALLOWED_ORIGINS=http://localhost:8080,https://axtec.tech,https://www.axtec.tech

# ---- AI provider (Anthropic) ----
# Required for AXTEC AI to hold real conversations.
# If missing, the API runs in FALLBACK mode (see src/services/aiProvider.js).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Database ----
# Leave DATABASE_URL empty to use the built-in local JSON file store
# (src/data/*.json) — fine for development and small volume.
# Set DATABASE_URL to switch automatically to PostgreSQL (Cloud SQL in production).
# Example: postgres://user:password@127.0.0.1:5432/axtec
DATABASE_URL=

# ---- Cache / rate limiting (Redis, optional) ----
# Leave empty to use the built-in in-memory store (fine for a single
# instance / dev). Set REDIS_URL to share rate-limit counters and the
# pricing cache across multiple instances (Cloud Run, load-balanced
# containers). Example: redis://:password@127.0.0.1:6379
REDIS_URL=
# How long GET /api/pricing responses are cached, in seconds.
PRICING_CACHE_TTL_SECONDS=30

# ---- Email (Nodemailer / SMTP) ----
# If left empty, emails are logged to the console instead of sent (SAFE for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AXTEC Technologies <no-reply@axtec.tech>"
MAIL_INTERNAL_TO=leads@axtec.tech

# ---- Admin ----
# Simple API key required to call /api/admin/* endpoints (pricing management).
# Generate a long random string for production.
ADMIN_API_KEY=change-me-please

# ---- Security ----
# Requests per IP allowed per window, for the built-in rate limiter.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---- Google Cloud (used only for deployment, not required to run locally) ----
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=
